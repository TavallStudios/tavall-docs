#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P)"
profile="${1:-}"

case "${profile}" in
    build|integration|all)
        ;;
    *)
        printf '%s\n' 'Usage: scripts/ci/verify <build|integration|all>' >&2
        exit 64
        ;;
esac

verify_expected_head() {
    local expected_head="${TAVALL_CI_EXPECTED_HEAD:-}"
    if [[ -z "${expected_head}" ]]; then
        return 0
    fi
    if [[ ! "${expected_head}" =~ ^([a-f0-9]{40}|[a-f0-9]{64})$ ]]; then
        printf '%s\n' 'TAVALL_CI_EXPECTED_HEAD must be a lowercase 40- or 64-character commit identifier' >&2
        exit 64
    fi
    local actual_head
    actual_head="$(git rev-parse HEAD)"
    if [[ "${actual_head}" != "${expected_head}" ]]; then
        printf 'verification source mismatch: expected=%s actual=%s\n' "${expected_head}" "${actual_head}" >&2
        exit 65
    fi
}

cd "${repository_root}"
verify_expected_head
mkdir -p "${TAVALL_CI_EVIDENCE_DIRECTORY:-${repository_root}/.tavall/local-ci/verify}"

python3 scripts/ci/test_verify_docs.py

case "${profile}" in
    build)
        python3 scripts/ci/verify_docs.py --mode build
        ;;
    integration|all)
        python3 scripts/ci/verify_docs.py --mode integration
        ;;
esac

verify_expected_head
